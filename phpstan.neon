# Static analysis of the PHP code (PHPStan installed by Composer, dev only):
#   composer install && composer phpstan
# The tests are analysed by phpstan.tests.neon (also run by composer phpstan)
# The rules of Carbure (tools/phpstan/) are loaded by the Composer autoloader
# (run by the pre-commit hook and the CI lint job)
# Use of deprecated PHP functions, classes and constants (phpstan-deprecation-rules)
includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    # Level 8: every parameter, return value and property has a type, the union types are
    # checked (a value that may be false: the result of a query, of strtotime()...) and so
    # are the nullable values (a row that may be null, a regex that may fail...)
    level: 8
    phpVersion: 80200
    paths:
        - src
        - swagger
        - tools
    excludePaths:
        - vendor

# Parameters, return values and properties typed in the code, not only in the PHPDoc
rules:
    - NativeTypesRule

# Cyclomatic complexity of each function or method (1 + one per decision)
services:
    -
        class: CyclomaticComplexityRule
        arguments:
            maxComplexity: 10
        tags:
            - phpstan.rules.rule
