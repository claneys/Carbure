{
    "name": "ltoinel/carbure",
    "description": "Household budget and bank transaction tracker (development tools only: the API has no dependency)",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.16"
    },
    "autoload-dev": {
        "classmap": ["tools/phpstan/"]
    },
    "scripts": {
        "phpstan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true
    }
}
