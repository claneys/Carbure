# Data of the instance: configuration, logs, cache, woob (bank credentials)
data/

# conf/ only holds versioned templates
# Development tools installed by Composer (composer install), at the root only:
# portal/vendor and swagger/vendor are self-hosted third-party assets, versioned
/vendor/

.phpunit.result.cache
.phpunit.cache/
CLAUDE.md

# End-to-end tests of the portal (tests/e2e)
tests/e2e/node_modules
tests/e2e/test-results/
tests/e2e/playwright-report/
tests/e2e/.data/

# Build cache of the documentation (Material privacy plugin: downloaded fonts)
.cache/

# Bytecode of the MkDocs hooks (overrides/hooks/)
__pycache__/
