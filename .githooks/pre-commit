#!/bin/sh
# Lint the staged PHP and JavaScript files, and check the types of the PHP code.
# Enable with: git config core.hooksPath .githooks

PHP=${PHP:-php}
status=0

files=$(git diff --cached --name-only --diff-filter=ACMR)

for file in $(echo "$files" | grep -E '\.php$'); do
    if ! command -v "$PHP" >/dev/null 2>&1; then
        echo "pre-commit: php not found, PHP lint skipped (set PHP=/path/to/php)" >&2
        break
    fi
    "$PHP" -l "$file" >/dev/null || status=1
done

# Types of the PHP code (PHPStan, see phpstan.neon): the whole code is analysed, a change
# of signature can break a caller in another file (result cached: fast after the first run)
if echo "$files" | grep -qE '\.php$|^phpstan\.neon$'; then
    if command -v "$PHP" >/dev/null 2>&1; then
        if [ ! -f vendor/bin/phpstan ]; then
            echo "pre-commit: PHPStan not installed, run: composer install" >&2
            status=1
        else
            "$PHP" vendor/bin/phpstan analyse --memory-limit=1G --no-progress || {
                echo "pre-commit: PHP types (PHPStan) not valid" >&2
                status=1
            }
        fi
    else
        echo "pre-commit: php not found, PHP types (PHPStan) not checked (set PHP=/path/to/php)" >&2
    fi
fi

for file in $(echo "$files" | grep -E '^portal/.*\.js$'); do
    if ! command -v node >/dev/null 2>&1; then
        echo "pre-commit: node not found, JavaScript lint skipped" >&2
        break
    fi
    # Portal files are ES modules: check them as .mjs
    tmp=$(mktemp --suffix=.mjs)
    cp "$file" "$tmp"
    node --check "$tmp" || { echo "  in $file" >&2; status=1; }
    rm -f "$tmp"
done

if [ $status -ne 0 ]; then
    echo "pre-commit: lint failed, commit aborted" >&2
fi
exit $status
