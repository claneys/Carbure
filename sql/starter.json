    "insights": [
        { "fr": "Dépenses", "en": "Expenses", "es": "Gastos", "it": "Spese", "de": "Ausgaben", "pt": "Despesas", "color": "red", "icon": "trending_down",
          "sql": "SELECT SUM(amount) AS amount FROM bank_transaction WHERE amount < 0 AND category NOT IN (SELECT id FROM bank_transaction_category WHERE type = 'HORS-BUDGET' AND id <> 0) AND MONTH(date) = {month} AND YEAR(date) = {year}" },
        { "fr": "Revenus", "en": "Income", "es": "Ingresos", "it": "Entrate", "de": "Einnahmen", "pt": "Receitas", "color": "green", "icon": "trending_up",
          "sql": "SELECT SUM(amount) AS amount FROM bank_transaction WHERE amount > 0 AND category NOT IN (SELECT id FROM bank_transaction_category WHERE type = 'HORS-BUDGET' AND id <> 0) AND MONTH(date) = {month} AND YEAR(date) = {year}" },
        { "fr": "Reste du mois", "en": "Left this month", "es": "Resto del mes", "it": "Resto del mese", "de": "Rest des Monats", "pt": "Resto do mês", "color": "blue", "icon": "account_balance_wallet",
          "sql": "SELECT SUM(amount) AS amount FROM bank_transaction WHERE category NOT IN (SELECT id FROM bank_transaction_category WHERE type = 'HORS-BUDGET' AND id <> 0) AND MONTH(date) = {month} AND YEAR(date) = {year}" },
        { "fr": "Épargne", "en": "Savings", "es": "Ahorro", "it": "Risparmio", "de": "Sparen", "pt": "Poupança", "color": "purple", "icon": "savings",
          "sql": "SELECT -SUM(amount) AS amount FROM bank_transaction WHERE category IN (31, 32, 33) AND MONTH(date) = {month} AND YEAR(date) = {year}" },
        { "fr": "Matelas de sécurité", "en": "Safety cushion", "es": "Colchón de seguridad", "it": "Cuscinetto sicurezza", "de": "Notgroschen", "pt": "Fundo de emergência", "color": "lime", "icon": "health_and_safety",
          "sql": "SELECT -SUM(amount) AS amount FROM bank_transaction WHERE amount < 0 AND category NOT IN (SELECT id FROM bank_transaction_category WHERE type = 'HORS-BUDGET' AND id <> 0) AND date >= MAKEDATE({year}, 1) + INTERVAL {month} - 7 MONTH AND date < MAKEDATE({year}, 1) + INTERVAL {month} - 1 MONTH" },
        { "fr": "Non catégorisé", "en": "Uncategorized", "es": "Sin categoría", "it": "Senza categoria", "de": "Ohne Kategorie", "pt": "Sem categoria", "color": "orange", "icon": "warning",
          "sql": "SELECT SUM(amount) AS amount FROM bank_transaction WHERE category = 0 AND MONTH(date) = {month} AND YEAR(date) = {year}" },
        { "fr": "Non vérifié", "en": "Unchecked", "es": "Sin revisar", "it": "Da verificare", "de": "Ungeprüft", "pt": "Por verificar", "color": "amber", "icon": "receipt_long",
          "sql": "SELECT SUM(amount) AS amount FROM bank_transaction WHERE pointed = 0 AND MONTH(date) = {month} AND YEAR(date) = {year}" },
        { "fr": "Prélèvements", "en": "Direct debits", "es": "Domiciliaciones", "it": "Addebiti diretti", "de": "Lastschriften", "pt": "Débitos diretos", "color": "indigo", "icon": "payments",
          "sql": "SELECT SUM(amount) AS amount FROM bank_transaction WHERE type = 2 AND MONTH(date) = {month} AND YEAR(date) = {year}" },
        { "fr": "Dépassement budget", "en": "Over budget", "es": "Exceso presupuesto", "it": "Fuori budget", "de": "Budgetüberschreitung", "pt": "Acima do orçamento", "color": "red", "icon": "pie_chart",
          "sql": "SELECT -SUM(GREATEST(0, -(SELECT IFNULL(SUM(t.amount), 0) FROM bank_transaction t JOIN bank_transaction_category c ON c.id = t.category WHERE (c.id = b.category OR c.parent_category = b.category) AND MONTH(t.date) = {month} AND YEAR(t.date) = {year}) - b.amount)) AS amount FROM budget b WHERE MONTH(b.date) = {month} AND YEAR(b.date) = {year}" },
        { "fr": "Plus grosse dépense", "en": "Largest expense", "es": "Mayor gasto", "it": "Spesa più alta", "de": "Größte Ausgabe", "pt": "Maior despesa", "color": "pink", "icon": "credit_card",
          "sql": "SELECT MIN(amount) AS amount FROM bank_transaction WHERE amount < 0 AND category NOT IN (SELECT id FROM bank_transaction_category WHERE type = 'HORS-BUDGET' AND id <> 0) AND MONTH(date) = {month} AND YEAR(date) = {year}" },
        { "fr": "Dépense par jour", "en": "Daily spending", "es": "Gasto diario", "it": "Spesa giornaliera", "de": "Ausgaben pro Tag", "pt": "Despesa diária", "color": "teal", "icon": "show_chart",
          "sql": "SELECT SUM(amount) / IF(YEAR(CURDATE()) = {year} AND MONTH(CURDATE()) = {month}, DAY(CURDATE()), DAY(LAST_DAY(MAKEDATE({year}, 1) + INTERVAL {month} - 1 MONTH))) AS amount FROM bank_transaction WHERE amount < 0 AND category NOT IN (SELECT id FROM bank_transaction_category WHERE type = 'HORS-BUDGET' AND id <> 0) AND MONTH(date) = {month} AND YEAR(date) = {year}" },
        { "fr": "Écart vs mois -1", "en": "Vs last month", "es": "Vs mes anterior", "it": "Vs mese prima", "de": "Vs. Vormonat", "pt": "Vs mês anterior", "color": "cyan", "icon": "analytics",
          "sql": "SELECT SUM(IF(MONTH(date) = {month}, amount, -amount)) AS amount FROM bank_transaction WHERE amount < 0 AND category NOT IN (SELECT id FROM bank_transaction_category WHERE type = 'HORS-BUDGET' AND id <> 0) AND date >= MAKEDATE({year}, 1) + INTERVAL {month} - 2 MONTH AND date < MAKEDATE({year}, 1) + INTERVAL {month} MONTH" },
        { "fr": "Retraits espèces", "en": "Cash withdrawals", "es": "Retiradas efectivo", "it": "Prelievi contanti", "de": "Bargeldabhebungen", "pt": "Levantamentos", "color": "gray", "icon": "local_atm",
          "sql": "SELECT SUM(amount) AS amount FROM bank_transaction WHERE type = 6 AND MONTH(date) = {month} AND YEAR(date) = {year}" },
        { "fr": "Frais bancaires", "en": "Bank fees", "es": "Comisiones", "it": "Spese bancarie", "de": "Bankgebühren", "pt": "Comissões bancárias", "color": "brown", "icon": "account_balance",
          "sql": "SELECT SUM(amount) AS amount FROM bank_transaction WHERE (category = 25 OR type = 9) AND MONTH(date) = {month} AND YEAR(date) = {year}" }
